+/*
+ * Stop one of the bus kthreads and drop the reference taken on it at creation.
+ *
+ * kthread_stop() waits for the thread to return from its function. A thread
+ * that died in an oops never returns, so kthread_stop() on it blocks forever
+ * (with the kernel's own refcount warning about the freed task_struct). That
+ * wait happens inside the USB probe/disconnect path holding the device lock,
+ * which then wedges the whole USB subtree until reboot. Detect the dead
+ * thread and skip the wait instead. The reference (get_task_struct at
+ * kthread_run time) is what makes reading the task fields safe here.
+ *
+ * PF_EXITING is set at the top of do_exit(); exit_state only in exit_notify()
+ * near its end. Checking both catches a thread that oopsed but has not yet
+ * finished dying. Both fields exist on every kernel this driver supports.
+ */
+static inline void aicwf_kthread_stop_safe(struct task_struct *t, const char *what)
+{
+    if (!t)
+        return;
+    if (READ_ONCE(t->exit_state) || (READ_ONCE(t->flags) & PF_EXITING)) {
+        pr_err("aicwf: %s (pid %d) already died; skipping kthread_stop to avoid hang\n",
+               what, t->pid);
+    } else {
+        kthread_stop(t);
+    }
+    put_task_struct(t);
+}

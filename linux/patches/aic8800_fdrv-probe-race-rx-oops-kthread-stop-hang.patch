-    rwnx_hw->cmd_mgr->msgind(rwnx_hw->cmd_mgr, msg,
-                            msg_hdlrs[MSG_T(msg->id)][MSG_I(msg->id)]);
+    unsigned int task = MSG_T(msg->id);
+    unsigned int idx  = MSG_I(msg->id);
+
+    /* The bus RX threads and URBs are started (aicwf_bus_init/aicwf_bus_start)
+     * before rwnx_cfg80211_init() allocates rwnx_hw and stores it in
+     * usbdev->rwnx_hw. A confirmation left over in the chip from a previous
+     * driver instance (fast unbind/bind, usbreset) arrives in that window with
+     * rwnx_hw == NULL. Dereferencing it oopses the RX kthread, which in turn
+     * makes the later kthread_stop() in aicwf_rx_deinit() hang forever. */
+    if (unlikely(!rwnx_hw || !rwnx_hw->cmd_mgr || !rwnx_hw->cmd_mgr->msgind)) {
+        AICWFDBG(LOGERROR, "%s: msg id 0x%x dropped, driver not ready (rwnx_hw=%p)\n",
+                 __func__, msg->id, rwnx_hw);
+        return;
+    }
+
+    if (unlikely(task >= ARRAY_SIZE(msg_hdlrs) || !msg_hdlrs[task] ||
+                 idx >= msg_hdlrs_len[task])) {
+        AICWFDBG(LOGERROR, "%s: msg id 0x%x (task %u idx %u) out of range, dropped\n",
+                 __func__, msg->id, task, idx);
+        return;
+    }
+
+    rwnx_hw->cmd_mgr->msgind(rwnx_hw->cmd_mgr, msg, msg_hdlrs[task][idx]);
 }
 
